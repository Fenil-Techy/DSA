		{
			"x": -21.284556859247317,
			"y": 212.1874942779541,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:nMQue59HZfGNLhzHKeNwg",
			"type": "text",
			"props": {
				"color": "red",
				"size": "s",
				"w": 476.12403958458145,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1.0274441477312433,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "for i in range(len(heights)):"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\twhile stack and height[i]<height[stack[-1]]:"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\tindex=stack.pop()"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\twidth=i-[index-1]-1"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\tarea=height*width"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\tmax_area=max(max_area,area)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\tstcak.append(i)"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b05uOJPAV",
			"typeName": "shape"
		},
