							},
							"content": [
								{
									"type": "text",
									"text": "i=0"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "for j in range(7):"
								}
